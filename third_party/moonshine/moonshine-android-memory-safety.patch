+class FloatArrayElements final {
+public:
+  FloatArrayElements(JNIEnv *env, jfloatArray array)
+      : env_(env), array_(array),
+        elements_(array == nullptr
+                      ? nullptr
+                      : env->GetFloatArrayElements(array, nullptr)) {
+    if (array_ != nullptr && elements_ == nullptr) {
+      throw std::runtime_error("Failed to acquire Java float-array elements");
+    }
+  }
+
+  ~FloatArrayElements() {
+    if (elements_ != nullptr) {
+      env_->ReleaseFloatArrayElements(array_, elements_, JNI_ABORT);
+    }
+  }
+
+  float *get() const { return elements_; }
+
+  FloatArrayElements(const FloatArrayElements &) = delete;
+  FloatArrayElements &operator=(const FloatArrayElements &) = delete;
+
+private:
+  JNIEnv *env_;
+  jfloatArray array_;
+  float *elements_;
+};
+
